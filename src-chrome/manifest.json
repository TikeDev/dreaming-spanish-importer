{
  "manifest_version": 3,
  "name": "Dreaming Spanish Importer",
  "version": "1.0.0",
  "description": "Automatically add watch/listening history to Dreaming Spanish from a file, Youtube, Spotify, Pocket Casts, or Disney Plus.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.open.spotify.com/*",
        "https://www.spotify.com/*",
        "https://open.spotify.com/*",
        "https://spotify.com/*",
        "https://www.youtube.com/watch*", 
        "https://www.play.pocketcasts.com/*",
        "https://www.pocketcasts.com/*",
        "https://play.pocketcasts.com/*",
        "https://pocketcasts.com/*"
        ],
        
      "js": ["yt-button-injector.js"]
    },
    {
      "matches": [
        "https://www.disneyplus.com/play*",
        "https://disneyplus.com/play*"
      ],
      "js": ["disneyplus-button-injector.js"]
    },    {
      "matches": [
        "https://www.dreamingspanish.com/*",
        "https://dreamingspanish.com/*"
      ],
      "js": ["ds-time-adder.js"]
    },
    {
      "matches": [
        "https://www.youtube.com/feed/history*" 
      ],
      "js": ["yt-history-button-injector.js"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["add_icon.jpeg","dreamingplus.png"],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.open.spotify.com/*",
        "https://www.spotify.com/*",
        "https://open.spotify.com/*",
        "https://spotify.com/*",
        "https://www.play.pocketcasts.com/*",
        "https://play.pocketcasts.com/*",
        "https://www.pocketcasts.com/*",
        "https://pocketcasts.com/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*"
      ]
    }
  ],
  "action": {}
}
