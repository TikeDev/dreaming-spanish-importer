{
  "manifest_version": 3,
  "name": "Dreaming Spanish Importer",
  "version": "1.0.0",
  "description": "Automatically add watch/listening history to Dreaming Spanish from a file, Youtube, Spotify, Pocket Casts, Disney Plus, or Netflix.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": "dreamingplus-black-bgwhite.png",
    "default_title": "Dreaming Spanish Importer"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*" 
        ],        
      "js": ["yt-button-injector.js"]
    },
    {
      "matches": [
        "https://www.open.spotify.com/*",
        "https://www.spotify.com/*",
        "https://open.spotify.com/*",
        "https://spotify.com/*"
      ],
      "js": ["spotify-button-injector.js"],
      "css": [ "styles-spotify.css" ]
    },
    {
      "matches": [
        "https://www.play.pocketcasts.com/*",
        "https://www.pocketcasts.com/*",
        "https://play.pocketcasts.com/*",
        "https://pocketcasts.com/*"
      ],
      "js": ["pocketcasts-button-injector.js"]
    },    
    {
      "matches": [
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*"
      ],
      "js": ["disneyplus-button-injector.js"]
    },    
    {
      "matches": [
        "https://www.netflix.com/*",
        "https://netflix.com/*"
      ],
      "js": ["netflix-button-injector.js"]
    },    
    {
      "matches": [
        "https://www.dreamingspanish.com/*",
        "https://dreamingspanish.com/*"
      ],
      "js": ["ds-time-adder.js"]
    }  
  ],
  "web_accessible_resources": [
    {
      "resources": ["dreamingplus*.png"],
      "matches": [
        "https://www.youtube.com/*",
        "https://www.open.spotify.com/*",
        "https://www.spotify.com/*",
        "https://open.spotify.com/*",
        "https://spotify.com/*",
        "https://www.play.pocketcasts.com/*",
        "https://play.pocketcasts.com/*",
        "https://www.pocketcasts.com/*",
        "https://pocketcasts.com/*",
        "https://www.disneyplus.com/*",
        "https://disneyplus.com/*",
        "https://www.netflix.com/*",
        "https://netflix.com/*"
      ]
    }
  ]
}
